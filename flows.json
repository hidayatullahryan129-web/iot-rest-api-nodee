    {
        "id": "16bec2b571dfae39",
        "type": "function",
        "z": "dd9dbcb9d079c7a5",
        "name": "Proses Sensor + Threshold",
        "func": "// Simpan data terakhir, cek threshold, siapkan 3 output\nconst d = msg.payload;\nd.received = new Date().toISOString();\nflow.set('lastSensor', d);\nconst th = flow.get('threshold') || 30;\nconst over = d.suhu > th;\nmsg.params = {$suhu: d.suhu, $kelembaban: d.kelembaban, $ts: d.timestamp, $received: d.received};\nconst ws = {payload: {type: 'sensor', data: d, threshold: th, alert: over}};\nlet al = null;\nif (over) {\n  al = {topic: 'iot/notifikasi', payload: {type: 'alert',\n        message: `Suhu ${d.suhu}°C melewati batas ${th}°C`,\n        suhu: d.suhu, threshold: th, time: d.received}};\n  node.warn(al.payload.message);\n}\nreturn [msg, ws, al];",
        "outputs": 3,
        "noerr": 0,
        "x": 410,
        "y": 100,
        "wires": [
            [
                "81a56d4f6c0e1592",
                "74a120249bf8ad2d"
            ],
            [
                "825dceeab3328f9c"
