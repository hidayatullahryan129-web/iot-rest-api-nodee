    {
        "id": "8f51526168e0c40c",
        "type": "function",
        "z": "dd9dbcb9d079c7a5",
        "name": "Validasi & Publish",
        "func": "const KEY = env.get('API_KEY') || 'iot-secret-123';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (msg.req.headers['x-api-key'] !== KEY) {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'API key tidak valid'};\n  return [msg, null];\n}\nconst body = msg.payload || {};\nif (!body.device || !body.action) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n  return [msg, null];\n}\nconst mqttMsg = {topic: 'iot/kontrol', payload: {device: body.device, action: body.action}};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: mqttMsg.payload};\nreturn [msg, mqttMsg];",
        "outputs": 2,
