        "type": "function",
        "z": "dd9dbcb9d079c7a5",
        "name": "Build Response Suhu",
        "func": "const KEY = env.get('API_KEY') || 'iot-secret-123';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (msg.req.headers['x-api-key'] !== KEY) {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'API key tidak valid'};\n  return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = {\n  status: 'success',\n  data: flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null},\n  threshold: flow.get('threshold') || 30,\n  server_time: new Date().toISOString()\n};\nreturn msg;",
