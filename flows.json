    {
        "id": "eedd344e54ece931",
        "type": "function",
        "z": "dd9dbcb9d079c7a5",
        "name": "Set Threshold",
        "func": "const KEY = env.get('API_KEY') || 'iot-secret-123';\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nif (msg.req.headers['x-api-key'] !== KEY) {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'API key tidak valid'};\n  return msg;\n}\nconst max = Number((msg.payload || {}).max);\nif (isNaN(max)) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'field \"max\" (angka) wajib diisi'};\n  return msg;\n}\nflow.set('threshold', max);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Threshold diperbarui', threshold: max};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
